# Optional local paths and server settings.
LAYA_HOST=127.0.0.1
LAYA_PORT=8000
# run_ui.sh detects these; set them only to override the detection.
# LAYA_DEVICE=cuda
# LAYA_REQUIRE_CUDA=true
LAYA_DATASETS_DIR=datasets
# LAYA_ACTIVE_DATASET=my-dataset
# LAYA_BENCHMARK_LABEL_SET=reviewers
LAYA_FINE_TUNED_MODELS_DIR=models/fine-tuned
LAYA_REVIEW_THRESHOLD=0.80

# Setup downloads model weights from these repositories into ignored paths.
# The setup scripts do not read this file; export these before running them.
# LAYA_HF_REPO_ID=convaiinnovations/laya
# LAYA_HF_REVISION=main
# LAYACRIME_HF_REPO_ID=leloss/LayaCrime-v0
# LAYACRIME_HF_REVISION=main

# Legacy loose-file overrides remain available for one-off datasets.
# LAYA_BENCHMARK_CORPUS=/private/path/benchmark-corpus.jsonl
# LAYA_BENCHMARK_LABELS=/private/path/benchmark-labels.jsonl

# Fine-tuning is enabled automatically only on loopback. Uncomment the next
# line to opt in on a remotely bound server. Protect such a server with
# authentication at a reverse proxy. Dataset bundles and model outputs are
# inside the project by default. Separate additional roots with ';' on Windows
# and ':' on Linux/macOS.
# LAYA_ENABLE_FINE_TUNING=true
LAYA_FINE_TUNING_ALLOWED_ROOTS=.